#include <stdio.h>

/* Else-if ladder */

char grade_if(int marks)
{
    if (marks < 0 || marks > 100)
        return '?';

    if (marks >= 90)
        return 'S';
    else if (marks >= 80)
        return 'A';
    else if (marks >= 70)
        return 'B';
    else if (marks >= 60)
        return 'C';
    else if (marks >= 50)
        return 'D';
    else
        return 'F';
}


/* Switch statement */

char grade(int marks)
{
    if (marks < 0 || marks > 100)
        return '?';

    switch (marks / 10)
    {
        case 10:
        case 9:
            return 'S';

        case 8:
            return 'A';

        case 7:
            return 'B';

        case 6:
            return 'C';

        case 5:
            return 'D';

        default:
            return 'F';
    }
}


int main(void)
{
    int marks[] = {100, 95, 83, 50, 49, -5,
                   90, 89, 80, 79, 70, 69,
                   60, 59, 0, 101};

    int i;

    printf("University Grade Classification\n\n");

    for (i = 0; i < 16; i++)
    {
        printf("%d:%c  ", marks[i], grade(marks[i]));
    }

    printf("\n\nElse-if and Switch Comparison\n");

    for (i = 0; i < 16; i++)
    {
        printf("%d: %c %c\n",
               marks[i],
               grade_if(marks[i]),
               grade(marks[i]));
    }

    return 0;
}
